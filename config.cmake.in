@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# this will let us find any installed FindXXX.cmake e.g., petsc / gmsh
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Public dependencies: needed by every consumer.
find_dependency(Kokkos CONFIG)
if(@PCMS_ENABLE_COUPLER@)
    # the coupler's public headers use redev (and through it ADIOS2 and MPI)
    find_dependency(redev 4.3.2 CONFIG)
    find_dependency(ADIOS2 CONFIG)
endif()
# MPI is public for the coupler and the C/Fortran APIs, private otherwise
if(@PCMS_ENABLE_COUPLER@ OR @PCMS_ENABLE_C@ OR @PCMS_ENABLE_FORTRAN@
   OR NOT @PCMS_BUILD_SHARED@)
    find_dependency(MPI)
endif()
if(@PCMS_ENABLE_OMEGA_H@)
    # a private dependency of the core libraries, and what users of the
    # Omega_h backend header (pcms/backends/omega_h/omega_h.hpp) link
    find_dependency(Omega_h CONFIG)
endif()
if(@PCMS_ENABLE_MFEM@)
    # the MFEM backend is part of pcms::field and links MFEM publicly
    find_dependency(MFEM CONFIG)
endif()

# Private dependencies: a shared PCMS resolves them itself (RPATH); a static
# PCMS needs them at the consumer's link step.
if(NOT @PCMS_BUILD_SHARED@)
    if(@PCMS_ENABLE_POLYNOMIAL_RECONSTRUCTION@)
        find_dependency(KokkosKernels CONFIG)
    endif()
    if(@PCMS_ENABLE_OMEGA_H_MESHFIELDS@)
        find_dependency(meshfields CONFIG)
    endif()
    if(@PCMS_ENABLE_CONSERVATIVE_PROJECTION@)
        if(NOT DEFINED PETSC_DIR)
            set(PETSC_DIR "@PETSC_DIR@")
        endif()
        if(NOT DEFINED PETSC_ARCH)
            set(PETSC_ARCH "@PETSC_ARCH@")
        endif()
        find_dependency(PETSc)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pcms_utility-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/pcms_transient-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/pcms_geometry-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/pcms_localization-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/pcms_field-targets.cmake")
if(@PCMS_ENABLE_COUPLER@)
    include("${CMAKE_CURRENT_LIST_DIR}/pcms_coupler-targets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/pcms_transfer-targets.cmake")

if(@PCMS_ENABLE_C@)
    if(@PCMS_ENABLE_COUPLER@)
        include("${CMAKE_CURRENT_LIST_DIR}/pcms_capi_core-targets.cmake")
    endif()
    if(@PCMS_ENABLE_OMEGA_H@)
        include("${CMAKE_CURRENT_LIST_DIR}/pcms_capi_transfer-targets.cmake")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/pcms_capi-targets.cmake")
endif()

if(@PCMS_ENABLE_FORTRAN@)
    if(@PCMS_ENABLE_COUPLER@)
        include("${CMAKE_CURRENT_LIST_DIR}/pcms_fortranapi_core-targets.cmake")
    endif()
    if(@PCMS_ENABLE_OMEGA_H@)
        include("${CMAKE_CURRENT_LIST_DIR}/pcms_fortranapi_transfer-targets.cmake")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/pcms_fortranapi-targets.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pcms-targets.cmake")
# deprecated pcms::core links pcms::pcms, so it is loaded after it
include("${CMAKE_CURRENT_LIST_DIR}/pcms_core-targets.cmake")
# must be called at the end of the config file
check_required_components(pcms)
