#ifndef PCMS_CONFIGURATION_HPP
#define PCMS_CONFIGURATION_HPP

#cmakedefine PCMS_ENABLE_OMEGA_H
#cmakedefine PCMS_ENABLE_OMEGA_H_MESHFIELDS
#cmakedefine PCMS_ENABLE_PETSC
#cmakedefine PCMS_ENABLE_UNITS
#cmakedefine PCMS_ENABLE_POLYNOMIAL_RECONSTRUCTION
#cmakedefine PCMS_ENABLE_XGC
#cmakedefine PCMS_ENABLE_MFEM
#cmakedefine PCMS_ENABLE_COUPLER
#cmakedefine PCMS_ENABLE_C
#cmakedefine PCMS_ENABLE_FORTRAN
#cmakedefine PCMS_ENABLE_PRINT

#cmakedefine PCMS_INTERSECTION_QUEUE_SIZE @PCMS_INTERSECTION_QUEUE_SIZE@
#cmakedefine PCMS_INTERSECTION_TRACK_SIZE @PCMS_INTERSECTION_TRACK_SIZE@

#cmakedefine PCMS_INTERSECTION_ABS_TOL @PCMS_INTERSECTION_ABS_TOL@
#cmakedefine PCMS_INTERSECTION_REL_TOL @PCMS_INTERSECTION_REL_TOL@
#cmakedefine PCMS_PROJECTION_KSP_RTOL @PCMS_PROJECTION_KSP_RTOL@
#cmakedefine PCMS_PROJECTION_KSP_ATOL @PCMS_PROJECTION_KSP_ATOL@

// deprecated spelling of PCMS_ENABLE_FORTRAN, kept for one release
#ifdef PCMS_ENABLE_FORTRAN
#define PCMS_ENABLE_Fortran
#endif

// deprecated spellings, kept for one release
#ifdef PCMS_ENABLE_OMEGA_H_MESHFIELDS
#define PCMS_ENABLE_MESHFIELDS
#endif
// the 0.4.0 flag of the configuration with MeshFields and PETSc
#if defined(PCMS_ENABLE_OMEGA_H_MESHFIELDS) && defined(PCMS_ENABLE_PETSC)
#define PCMS_ENABLE_CONSERVATIVE_PROJECTION
#endif
// the timestepper is always built
#define PCMS_ENABLE_TRANSIENT

#endif // PCMS_CONFIGURATION_HPP
